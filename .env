# URL de la base de datos (SQLite por defecto para desarrollo)
# Para cambiar a PostgreSQL/SQL Server, simplemente modifica esta variable:
# DATABASE_URL=postgresql://user:password@localhost/dbname
# Configuración de base de datos para SQL Server Express 2022
# Nota: Asegúrate de que el nombre del host (local o IP) sea accesible.
# Para Windows Auth de Mac a Windows, se requiere configuración de Kerberos.
DATABASE_URL="mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+17+for+SQL+Server%7D%3BSERVER%3DDESKTOP-HGFTM8G%5CSQLEXPRESS%3BDATABASE%3DDrMotorDB%3BTrusted_Connection%3Dyes%3B"
SECRET_KEY=super-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
